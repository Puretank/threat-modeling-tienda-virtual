              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "59d8fc91-28d6-4e71-b8e7-813ab45ac947",
                  "title": "S-01 - Suplantación de identidad mediante robo de credenciales",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Un atacante podría obtener las credenciales de un usuario y utilizarlas para hacerse pasar por él, obteniendo acceso no autorizado a su cuenta, información personal y pedidos.",
                  "mitigation": "Implementar autenticación multifactor (MFA), exigir contraseñas robustas, limitar los intentos de inicio de sesión, implementar protección contra ataques de fuerza bruta y utilizar una gestión segura de sesiones.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "7a87ed5c-a1f2-410d-ba6e-407aa331db79",
                  "title": "R-01 - Repudio de una compra",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Un usuario podría negar haber realizado una compra si el sistema no cuenta con registros suficientes que permitan demostrar quién realizó la operación, cuándo se realizó y qué productos fueron adquiridos.",
                  "mitigation": "Implementar registros de auditoría (logs) para las operaciones de compra, asociando cada transacción con un identificador único, usuario, fecha y hora. Los registros deben protegerse contra modificaciones no autorizadas y conservarse durante un período definido.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "9921fa4d-c5f8-4a81-8205-44e4a345f17f",
                  "title": "I-01 - Exposición de información personal",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "La aplicación podría exponer información personal de los usuarios, como nombre, correo electrónico, dirección, teléfono o datos de la cuenta, a personas que no tienen autorización para acceder a ella. Un atacante podría intentar modificar parámetros o URL para consultar información perteneciente a otros usuarios.",
                  "mitigation": "Implementar controles de autorización en el servidor para verificar que cada usuario solamente pueda acceder a los recursos que le corresponden. No confiar en identificadores enviados mediante la URL. Aplicar el principio de mínimo privilegio, evitar exponer información personal innecesaria y redireccionar o rechazar las solicitudes no autorizadas.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "f6e843d7-c6d8-418c-abe5-d62826b742e5",
                  "title": "D-01 - Denegación de servicio por exceso de peticiones",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Un atacante podría enviar un número excesivo de solicitudes al servidor o a determinados servicios de la aplicación, consumiendo recursos como CPU, memoria o conexiones y provocando lentitud o indisponibilidad para los usuarios legítimos.",
                  "mitigation": "Implementar rate limiting para limitar el número de solicitudes por usuario o dirección IP, bloqueo temporal ante patrones de abuso, CAPTCHA en operaciones sensibles y mecanismos de monitoreo y detección de tráfico anómalo.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "65d6007e-55b5-41dc-9653-963e96fe9bfe",
                  "title": "E-01 - Elevación no autorizada de privilegios",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Elevation of privilege",
                  "description": "Un usuario con privilegios normales podría intentar acceder a funciones administrativas o modificar parámetros de las solicitudes para obtener permisos de administrador. Esto podría permitirle modificar productos, precios, pedidos o información de otros usuarios.",
                  "mitigation": "Implementar un sistema de control de acceso basado en roles (RBAC), verificando los permisos de cada usuario en el servidor antes de ejecutar operaciones administrativas. No confiar únicamente en restricciones implementadas en el cliente. Aplicar el principio de mínimo privilegio, validar los permisos en cada solicitud y registrar las operaciones administrativas.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "tampering": 0,
                "repudiation": 1,
                "informationDisclosure": 1,
                "denialOfService": 1,
                "elevationOfPrivilege": 1
              }
            }
          },
